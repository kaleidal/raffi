{
  "name": "@raffi/desktop",
  "private": true,
  "version": "0.12.0",
  "type": "module",
  "main": "electron/main.cjs",
  "description": "A modern video player",
  "author": {
    "name": "Kaleidal",
    "email": "hello@kaleid.al"
  },
  "homepage": "https://raffi.al",
  "desktopName": "raffi.desktop",
  "scripts": {
    "dev": "vite --strictPort",
    "electron:dev": "bun run prepare:ffmpeg && cross-env NODE_ENV=development concurrently -k \"bun run dev\" \"wait-on http://localhost:5173 && cross-env ELECTRON_DISABLE_SANDBOX=1 electron .\"",
    "electron:dev:only": "bun run prepare:ffmpeg && cross-env ELECTRON_DISABLE_SANDBOX=1 electron .",
    "build": "bun scripts/build-electron.mjs && vite build",
    "prepare:ffmpeg": "bun scripts/prepare-ffmpeg.mjs",
    "dist": "bun run prepare:ffmpeg && bun run build && electron-builder",
    "check": "svelte-check --tsgo --tsconfig ./tsconfig.json",
    "check:all": "bun run --filter @raffi/app check && bun run check",
    "test:playback": "bun run prepare:ffmpeg && bun test tests/playback-matrix.test.ts"
  },
  "devDependencies": {
    "@typescript/native": "npm:typescript@^7.0.2",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^26.2.0",
    "@raffi/app": "workspace:*",
    "@ryuziii/discord-rpc": "^1.0.1-rc.1",
    "@tailwindcss/vite": "^4.3.3",
    "concurrently": "^10.0.4",
    "cross-env": "^10.1.0",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "electron-updater": "^6.8.9",
    "svelte": "^5.56.8",
    "svelte-check": "^4.7.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.2",
    "vite": "^8.2.1",
    "wait-on": "^9.1.0"
  },
  "build": {
    "appId": "al.kaleid.raffi",
    "productName": "Raffi",
    "extraMetadata": {
      "main": "electron-dist/main.cjs"
    },
    "electronLanguages": [
      "en-US"
    ],
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "publish": {
      "provider": "github",
      "owner": "kaleidal",
      "repo": "raffi"
    },
    "files": [
      "dist/**/*",
      "electron-dist/**/*",
      "LICENSE",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "vendor/ffmpeg",
        "to": "ffmpeg"
      }
    ],
    "asar": true,
    "linux": {
      "syncDesktopName": true,
      "target": [
        "deb",
        "AppImage",
        "rpm"
      ],
      "artifactName": "Raffi-${version}-${arch}.${ext}",
      "executableName": "raffi",
      "icon": "build/icons",
      "category": "Video"
    },
    "deb": {
      "packageName": "raffi"
    },
    "rpm": {
      "packageName": "raffi"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "icon": "build/icons/icon.icns",
      "category": "public.app-category.video",
      "identity": null
    },
    "win": {
      "target": [
        "nsis",
        "msi"
      ],
      "icon": "build/icons/icon.ico"
    },
    "fileAssociations": [
      {
        "ext": "mp4",
        "name": "Video File",
        "role": "Viewer"
      },
      {
        "ext": "mkv",
        "name": "Video File",
        "role": "Viewer"
      },
      {
        "ext": "avi",
        "name": "Video File",
        "role": "Viewer"
      },
      {
        "ext": "webm",
        "name": "Video File",
        "role": "Viewer"
      },
      {
        "ext": "mov",
        "name": "Video File",
        "role": "Viewer"
      }
    ]
  },
  "trustedDependencies": [
    "core-js",
    "electron",
    "protobufjs"
  ]
}
