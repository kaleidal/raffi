{
  "name": "@raffi/desktop",
  "private": true,
  "version": "0.17.0",
  "type": "module",
  "main": "electron/main.cjs",
  "description": "A modern video player",
  "author": {
    "name": "Kaleidal",
    "email": "hello@kaleid.al"
  },
  "homepage": "https://raffi.al",
  "desktopName": "raffi.desktop",
  "scripts": {
    "dev": "vite --strictPort",
    "electron:dev": "cross-env NODE_ENV=development concurrently -k \"bun run dev\" \"wait-on http://localhost:43173 && cross-env ELECTRON_DISABLE_SANDBOX=1 electron .\"",
    "electron:dev:only": "cross-env ELECTRON_DISABLE_SANDBOX=1 electron .",
    "build": "bun scripts/build-electron.mjs && vite build",
    "dist": "bun run build && electron-builder",
    "check": "svelte-check --tsgo --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json",
    "check:all": "bun run --filter @raffi/app check && bun run check",
    "test": "bun test tests",
    "test:playback": "bun run test"
  },
  "devDependencies": {
    "@mediabunny/dts": "^1.65.2",
    "@mediabunny/truehd": "^1.65.2",
    "@raffi/app": "workspace:*",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.5",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^26.6.6",
    "@typescript/native": "npm:typescript@^7.0.2",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "electron-updater": "^6.8.11",
    "mediabunny": "^1.65.2",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "vite": "^8.3.6",
    "wait-on": "^9.5.1"
  },
  "build": {
    "appId": "al.kaleid.raffi",
    "productName": "Raffi",
    "extraMetadata": {
      "main": "electron-dist/main.cjs"
    },
    "toolsets": {
      "appimage": "1.0.3"
    },
    "electronLanguages": [
      "en-US"
    ],
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://dl.schelf.store/kaleidal/raffi",
        "useMultipleRangeRequest": false
      },
      {
        "provider": "github",
        "owner": "kaleidal",
        "repo": "raffi",
        "releaseType": "draft"
      }
    ],
    "files": [
      "dist/**/*",
      "electron-dist/**/*",
      "LICENSE",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/icons/512x512.png",
        "to": "icon.png"
      }
    ],
    "asar": true,
    "linux": {
      "syncDesktopName": true,
      "target": [
        "deb",
        "AppImage",
        "rpm"
      ],
      "artifactName": "Raffi-${version}-${arch}.${ext}",
      "executableName": "raffi",
      "icon": "build/icons",
      "category": "AudioVideo;Video"
    },
    "deb": {
      "packageName": "raffi"
    },
    "rpm": {
      "packageName": "raffi"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "icon": "build/icons/icon.icns",
      "category": "public.app-category.video",
      "identity": null
    },
    "win": {
      "target": [
        "nsis",
        "msi"
      ],
      "icon": "build/icons/icon.ico"
    },
    "nsis": {
      "artifactName": "Raffi-Setup-${version}.${ext}"
    },
    "msi": {
      "artifactName": "Raffi-${version}.${ext}"
    },
    "fileAssociations": [
      {
        "ext": "mp4",
        "name": "Video File",
        "role": "Viewer"
      },
      {
        "ext": "mkv",
        "name": "Video File",
        "role": "Viewer"
      },
      {
        "ext": "avi",
        "name": "Video File",
        "role": "Viewer"
      },
      {
        "ext": "webm",
        "name": "Video File",
        "role": "Viewer"
      },
      {
        "ext": "mov",
        "name": "Video File",
        "role": "Viewer"
      }
    ]
  },
  "trustedDependencies": [
    "core-js",
    "electron",
    "protobufjs"
  ]
}
