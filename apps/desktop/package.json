{
  "name": "@raffi/desktop",
  "private": true,
  "version": "0.12.0",
  "type": "module",
  "main": "electron/main.cjs",
  "description": "A modern video player",
  "author": {
    "name": "Kaleidal",
    "email": "hello@kaleid.al"
  },
  "homepage": "https://raffi.al",
  "scripts": {
    "dev": "vite --strictPort",
    "electron:dev": "cross-env NODE_ENV=development concurrently -k \"bun run dev\" \"wait-on http://localhost:5173 && cross-env ELECTRON_DISABLE_SANDBOX=1 electron .\"",
    "electron:dev:only": "cross-env ELECTRON_DISABLE_SANDBOX=1 electron .",
    "build": "vite build",
    "dist": "bun run build && electron-builder",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "check:all": "bun run --filter @raffi/app check && bun run check"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^26.1.1",
    "concurrently": "^10.0.3",
    "cross-env": "^10.1.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "svelte": "^5.56.7",
    "svelte-check": "^4.7.3",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "wait-on": "^9.1.0"
  },
  "build": {
    "appId": "al.kaleid.raffi",
    "productName": "Raffi",
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "publish": {
      "provider": "github",
      "owner": "kaleidal",
      "repo": "raffi"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asar": true,
    "linux": {
      "target": [
        "deb",
        "AppImage",
        "rpm"
      ],
      "artifactName": "Raffi-${version}-${arch}.${ext}",
      "executableName": "raffi",
      "icon": "build/icons",
      "category": "Video"
    },
    "deb": {
      "packageName": "raffi"
    },
    "rpm": {
      "packageName": "raffi"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "x64ArchFiles": "**/Contents/Resources/app.asar.unpacked/node_modules/**",
      "icon": "build/icons/icon.icns",
      "category": "public.app-category.video",
      "identity": null
    },
    "win": {
      "target": [
        "nsis",
        "msi"
      ],
      "icon": "build/icons/icon.ico"
    },
    "fileAssociations": [
      {
        "ext": "mp4",
        "name": "Video File",
        "role": "Viewer"
      },
      {
        "ext": "mkv",
        "name": "Video File",
        "role": "Viewer"
      },
      {
        "ext": "avi",
        "name": "Video File",
        "role": "Viewer"
      },
      {
        "ext": "webm",
        "name": "Video File",
        "role": "Viewer"
      },
      {
        "ext": "mov",
        "name": "Video File",
        "role": "Viewer"
      }
    ],
    "asarUnpack": [
      "node_modules/**/*.node",
      "node_modules/**/prebuilds/**"
    ]
  },
  "dependencies": {
    "@raffi/app": "workspace:*",
    "@ryuziii/discord-rpc": "^1.0.1-rc.1",
    "@tailwindcss/vite": "^4.3.3",
    "electron-updater": "^6.8.9",
    "tailwindcss": "^4.3.3"
  },
  "trustedDependencies": [
    "core-js",
    "electron",
    "protobufjs"
  ]
}
