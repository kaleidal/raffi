    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.1.1",
    "svelte": "^5.56.7",
    "svelte-check": "^4.7.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "wrangler": "^4.114.0"
  },
  "dependencies": {
    "@ave-id/sdk": "^0.10.1",
    "@lucide/svelte": "^1.26.0",
    "@raffi/app": "workspace:*",
    "hls.js": "^1.6.16",
    "posthog-js": "^1.407.2"
  }
}