{
  "extends": "@tsconfig/svelte/tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "types": ["svelte", "vite/client"],
    "moduleDetection": "force",
    "moduleResolution": "bundler",
    "noEmit": true,
    "paths": {
      "@raffi/app/*": ["../../packages/app/*"],
      "@raffi/app": ["../../packages/app/src"]
    }
  },
  "include": ["main.ts"]
}
