{
  "name": "raffi",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:web": "bun --filter @raffi/web dev",
    "build:web": "bun --filter @raffi/web build",
    "check:web": "bun --filter @raffi/web check",
    "dev:desktop": "bun --filter @raffi/desktop electron:dev",
    "build:desktop": "bun --filter @raffi/desktop build",
    "check:desktop": "bun --filter @raffi/desktop check",
    "check:app": "bun --filter @raffi/app check",
    "check:sync": "bun --filter @raffi/sync check",
    "check:marketing": "bun --filter @raffi/marketing check",
    "test:app": "bun test packages/app/tests",
    "test:sync": "bun --filter @raffi/sync test",
    "test:playback": "bun --filter @raffi/desktop test:playback",
    "test": "bun run test:app && bun run test:sync && bun run test:playback",
    "check": "bun run check:app && bun run check:web && bun run check:desktop && bun run check:sync && bun run check:marketing",
    "validate": "bun run check && bun run test"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*",
    "marketing"
  ],
  "overrides": {
    "brace-expansion": "1.1.18",
    "cookie": "0.7.2",
    "fast-uri": "3.1.5",
    "form-data": "4.0.6",
    "js-yaml": "4.3.1",
    "tar": "7.5.22",
    "undici": "7.29.0"
  }
}
